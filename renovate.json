{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Tallinn",
  "ignorePaths": [
    "k8s/mkv-strip/mkv-strip-cronjob.yaml",
    "k8s/mkv-strip/mkv-strip-job.yaml"
  ],
  "kubernetes": {
    "fileMatch": ["^k8s/.*\\.yaml$"]
  },
  "argocd": {
    "fileMatch": ["^k8s/argocd/applications/.*\\.yaml$"]
  },
  "helmfile": {
    "fileMatch": ["^k8s/argocd/argocd-helmfile\\.yaml$"]
  },
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": true,
  "pinDigests": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Auto-merge minor, patch, digest and digest-pin updates for everything",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "No release-age gate on digests. They track mutable tags that get rebuilt upstream, which resets the age clock every run, so renovate/stability-days hangs pending forever and the branch is never green.",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Always auto-merge (including major) for selected apps",
      "matchFileNames": [
        "k8s/jellyfin/**",
        "k8s/qbittorrent/**",
        "k8s/stump/**",
        "k8s/vaultwarden/**",
        "k8s/memos/**",
        "k8s/linkwarden/**",
        "k8s/librespeed/**",
        "k8s/homeassistant/**"
      ],
      "automerge": true
    },
    {
      "description": "Critical infra: hold minor updates for the weekend so I have time to fix breakage. Patch releases are left to merge as soon as they are green.",
      "matchPackageNames": [
        "cilium",
        "traefik",
        "cert-manager",
        "external-secrets",
        "argo-cd",
        "kube-prometheus-stack",
        "authentik",
        "nextcloud"
      ],
      "matchUpdateTypes": ["minor"],
      "automergeSchedule": ["every weekend"]
    },
    {
      "description": "Never auto-merge the Meilisearch search DB used by Linkwarden",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["getmeili/meilisearch"],
      "automerge": false
    },
    {
      "description": "Never auto-merge the Proxmox Terraform provider",
      "matchManagers": ["terraform"],
      "automerge": false
    },
    {
      "description": "Rook Ceph storage charts: minor and major land as manual PRs so I can review CRD and OSD changes first",
      "matchPackageNames": ["rook-ceph", "rook-ceph-cluster", "ceph-csi-drivers"],
      "automerge": false
    },
    {
      "description": "Exception: Ceph patch releases are bugfix-only and safe to auto-merge",
      "matchPackageNames": ["rook-ceph", "rook-ceph-cluster", "ceph-csi-drivers"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
