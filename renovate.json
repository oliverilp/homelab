{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Tallinn",
  "ignorePaths": [
    "k8s/mkv-strip/mkv-strip-cronjob.yaml",
    "k8s/mkv-strip/mkv-strip-job.yaml"
  ],
  "kubernetes": {
    "fileMatch": ["^k8s/.*\\.yaml$"]
  },
  "argocd": {
    "fileMatch": ["^k8s/argocd/applications/.*\\.yaml$"]
  },
  "helmfile": {
    "fileMatch": ["^k8s/argocd/argocd-helmfile\\.yaml$"]
  },
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "pinDigests": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeSchedule": ["* 5 * * *"],
  "packageRules": [
    {
      "description": "Auto-merge minor, patch, digest and digest-pin updates for everything",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Always auto-merge (including major) for selected apps",
      "matchFileNames": [
        "k8s/jellyfin/**",
        "k8s/qbittorrent/**",
        "k8s/stump/**",
        "k8s/vaultwarden/**",
        "k8s/memos/**",
        "k8s/linkwarden/**",
        "k8s/librespeed/**",
        "k8s/homeassistant/**"
      ],
      "automerge": true
    },
    {
      "description": "Never auto-merge the Meilisearch search DB used by Linkwarden",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["getmeili/meilisearch"],
      "automerge": false
    },
    {
      "description": "Never auto-merge the Proxmox Terraform provider",
      "matchManagers": ["terraform"],
      "automerge": false
    }
  ]
}
