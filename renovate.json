{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "k8s/mkv-strip/mkv-strip-cronjob.yaml",
    "k8s/mkv-strip/mkv-strip-job.yaml"
  ],
  "kubernetes": {
    "fileMatch": ["^k8s/.*\\.yaml$"]
  },
  "argocd": {
    "fileMatch": ["^k8s/argocd/applications/.*\\.yaml$"]
  },
  "helmfile": {
    "fileMatch": ["^k8s/argocd/argocd-helmfile\\.yaml$"]
  }
}
